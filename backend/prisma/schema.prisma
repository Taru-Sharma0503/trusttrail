generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DONOR
  NGO_ADMIN
  NGO_SIGNATORY
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  PAUSED
}

enum MilestoneStatus {
  PENDING
  SUBMITTED
  APPROVED
  RELEASED
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum AnomalySeverity {
  LOW
  MEDIUM
  HIGH
}

model User {
  id             String      @id @default(cuid())
  walletAddress  String      @unique
  email          String?     @unique
  role           Role        @default(DONOR)
  nonce          String?
  nonceExpiresAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  ngoMemberships NgoMember[]
  receipts       Receipt[]   @relation("ReceiptUploader")
}

model NGO {
  id                 String             @id @default(cuid())
  name               String
  description        String?
  walletAddress      String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  campaigns          Campaign[]
  members            NgoMember[]
}

model NgoMember {
  ngoId  String
  userId String
  ngo    NGO    @relation(fields: [ngoId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ngoId, userId])
}

model Campaign {
  id                        String         @id @default(cuid())
  ngoId                     String
  name                      String
  description               String?
  targetAmount              Decimal        @db.Decimal(36, 18)
  blockchainContractAddress String?
  chainId                   Int
  status                    CampaignStatus @default(DRAFT)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  ngo                       NGO            @relation(fields: [ngoId], references: [id])
  categories                Category[]
  milestones                Milestone[]
  donations                 Donation[]
  withdrawals               Withdrawal[]
  receipts                  Receipt[]
}

model Category {
  id            String       @id @default(cuid())
  campaignId    String
  name          String
  description   String?
  allocationCap Decimal      @db.Decimal(36, 18)
  spentAmount   Decimal      @default(0) @db.Decimal(36, 18)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  campaign      Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  withdrawals   Withdrawal[]
}

model Milestone {
  id           String          @id @default(cuid())
  campaignId   String
  title        String
  description  String?
  targetAmount Decimal         @db.Decimal(36, 18)
  status       MilestoneStatus @default(PENDING)
  proofHash    String?
  createdAt    DateTime        @default(now())
  completedAt  DateTime?
  campaign     Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  withdrawals  Withdrawal[]
  receipts     Receipt[]
}

model Donation {
  id                 String            @id @default(cuid())
  campaignId         String
  donorWalletAddress String
  amount             Decimal           @db.Decimal(36, 18)
  transactionHash    String            @unique
  blockNumber        Int?
  timestamp          DateTime          @default(now())
  status             TransactionStatus @default(PENDING)
  campaign           Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id                     String           @id @default(cuid())
  campaignId             String
  categoryId             String?
  milestoneId            String?
  recipientWalletAddress String
  amount                 Decimal          @db.Decimal(36, 18)
  transactionHash        String           @unique
  blockNumber            Int?
  timestamp              DateTime         @default(now())
  anomalyScore           Int              @default(0)
  anomalySeverity        AnomalySeverity?
  anomalyReason          String?
  flagged                Boolean          @default(false)
  campaign               Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  category               Category?        @relation(fields: [categoryId], references: [id])
  milestone              Milestone?       @relation(fields: [milestoneId], references: [id])
  receipts               Receipt[]
}

model Receipt {
  id           String      @id @default(cuid())
  campaignId   String
  milestoneId  String?
  withdrawalId String?
  ipfsCid      String
  contentHash  String
  fileName     String
  mimeType     String
  uploadedById String
  createdAt    DateTime    @default(now())
  campaign     Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  milestone    Milestone?  @relation(fields: [milestoneId], references: [id])
  withdrawal   Withdrawal? @relation(fields: [withdrawalId], references: [id])
  uploadedBy   User        @relation("ReceiptUploader", fields: [uploadedById], references: [id])

  @@unique([contentHash, campaignId])
}

model BlockchainEvent {
  id              String   @id @default(cuid())
  contractAddress String
  chainId         Int
  eventName       String
  transactionHash String
  logIndex        Int
  blockNumber     Int
  payload         Json
  processedAt     DateTime @default(now())

  @@unique([transactionHash, logIndex, contractAddress])
}

model IndexerState {
  id               String    @id @default("default")
  lastIndexedBlock Int       @default(0)
  lastSuccessfulAt DateTime?
  updatedAt        DateTime  @updatedAt
}